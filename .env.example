# Copy to .env.local for development. Set the same keys in Vercel (Project → Settings → Environment Variables).

# Public base URL for images and video on Cloudflare R2
NEXT_PUBLIC_ASSET_BASE_URL=https://assets.nathmond.co.uk

# Google Analytics 4 measurement ID (optional)
GA_ID=

# Contact form (Resend)
RESEND_API_KEY=
CONTACT_FROM_EMAIL="Nathmond Website <website@nathmond.co.uk>"
CONTACT_TO_EMAIL=studio@nathmond.co.uk
# Optional: lock the contact API to your domain
CONTACT_ALLOWED_ORIGIN=https://www.nathmond.co.uk

# Only needed locally to upload media with `npm run assets:upload` (never set these in Vercel)
R2_ACCOUNT_ID=
R2_BUCKET_NAME=portfolio-asset
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
